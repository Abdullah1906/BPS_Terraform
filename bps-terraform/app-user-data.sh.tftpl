#!/bin/bash
set -euxo pipefail

apt-get update
apt-get install -y curl wget unzip ca-certificates awscli

wget -q https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb \
  -O /tmp/packages-microsoft-prod.deb

dpkg -i /tmp/packages-microsoft-prod.deb
apt-get update
apt-get install -y aspnetcore-runtime-8.0

mkdir -p /opt/bps/current /opt/bps/releases /etc/bps

SECRET_JSON="$(aws secretsmanager get-secret-value \
  --secret-id "${sql_secret_arn}" \
  --query SecretString \
  --output text \
  --region "${AWS_DEFAULT_REGION:-ap-south-1}")"

SQL_PASSWORD="$(echo "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["password"])')"

cat > /etc/bps/bps.env <<EOF
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000
ConnectionStrings__DefaultConnection=Server=${sql_private_ip},1433;Database=BPS;User Id=sa;Password=${SQL_PASSWORD};TrustServerCertificate=True;
EOF

chmod 600 /etc/bps/bps.env

cat > /etc/systemd/system/bps-api.service <<'EOF'
[Unit]
Description=BPS .NET 8 API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/bps/current
ExecStart=/usr/bin/dotnet /opt/bps/current/BPS.Api.dll
Restart=always
RestartSec=10
EnvironmentFile=/etc/bps/bps.env
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable bps-api

echo "BPS application server ready. Waiting for CI/CD deployment." \
  > /opt/bps/READY.txt
